# PavePulse Environment Configuration

# Flask Application Settings
SECRET_KEY=change-this-to-a-secure-random-secret-key
FLASK_ENV=production
DEBUG=False
PORT=5000

# Database Configuration
# Local SQLite fallback (default): sqlite:///pavepulse.db
# MySQL on EC2: mysql+pymysql://pavepulse_user:StrongPassword123!@localhost/pavepulse_db
# Amazon RDS MySQL: mysql+pymysql://admin:StrongPassword123!@pavepulse-db.xxxxx.ap-south-1.rds.amazonaws.com/pavepulse_db
DATABASE_URL=sqlite:///pavepulse.db

# AWS Cloud Storage Configuration (Amazon S3)
# Leave S3_BUCKET empty for automatic local storage fallback during local testing
S3_BUCKET=pavepulse-hazard-photos-ap-south-1
AWS_DEFAULT_REGION=ap-south-1
# When running on EC2 with an attached IAM Role, leave ACCESS_KEY & SECRET_KEY empty!
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Upload Limits
MAX_CONTENT_LENGTH=10485760 # 10MB in bytes
